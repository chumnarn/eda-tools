@echo off
rem ==========================================================================
rem  Generic batch runner for the QuestaSim VHDL labs
rem
rem  Generated by tools\make-runners.ps1 -- change the template, not the copies.
rem
rem  Usage :  run.cmd            (green entry point)
rem           run_fail.cmd       (negative test, expected to fail)
rem           run_debug.cmd      (debug session, expected to pass)
rem
rem  Exit code : 0 = PASS, 1 = FAIL, 2 = wrong folder / tool not found
rem
rem  RULES for .cmd files on Windows (all of them verified on this machine):
rem    * Keep the file pure ASCII. Thai or UTF-8 text in a .cmd file makes
rem      cmd.exe mis-read the line structure -- a comment line can swallow
rem      the first character of the next line ("echo" becomes "cho").
rem    * Never leave an unescaped "(" or ")" inside an echo line that sits
rem      inside an if-block. cmd.exe reports a syntax error and aborts the
rem      whole script without printing anything.
rem    * vsim returns 0 even when it cannot open the .do file, so never
rem      trust the exit code alone -- check the result file as well.
rem    * The licence is a single-session node-locked licence, so the tool
rem      is chosen by tools\pick_tool.cmd, which probes the candidates.
rem ==========================================================================
setlocal

call "%~dp0..\tools\pick_tool.cmd"
if not defined MT (
    echo [ERROR] no usable vsim.exe with a free licence was found.
    echo         Close any running ModelSim/QuestaSim GUI, or set
    echo         QUESTASIM_HOME / MODELSIM_HOME to a valid installation.
    exit /b 2
)
set "PATH=%MT%;%PATH%"
cd /d "%~dp0"
if not exist "__SCRIPT__" (
    echo [ERROR] __SCRIPT__ not found in %CD%
    exit /b 2
)

echo =====================================================================
echo  __LABNAME__
echo  cwd    : %CD%
echo  tool   : %MT%
echo  expect : __EXPECT__
echo =====================================================================

if exist result.txt del result.txt

vsim -c -onfinish stop __EXTRA__ -do "do __SCRIPT__"
set RC=%ERRORLEVEL%

if not exist "result.txt" (
    echo [RESULT] FAIL -- the simulator did not finish
    exit /b 1
)

set /p RESULT=<result.txt
if /i "%RESULT%"=="PASS" (
    echo [RESULT] PASS
    exit /b 0
)
echo [RESULT] FAIL -- exit=%RC%
exit /b 1
