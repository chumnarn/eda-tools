#=====================================================================
# run.do  --  LAB 01 : การจำลองครั้งแรก (แบบ GUI)
#---------------------------------------------------------------------
# วิธีใช้
#   1) เปิด QuestaSim
#   2) File > Change Directory...  -> เลือกโฟลเดอร์ lab01_first_simulation
#   3) พิมพ์คำสั่งนี้ที่ prompt ในหน้าต่าง Transcript:
#          source run.do
#   (ใช้ "source" ไม่ใช่ "do" เพราะ source จะทำให้ info script ส่งค่า
#    path ของไฟล์ .do อย่างถูกต้อง -- ดูบทแทรก F)
#
#   ถ้าต้องการรันแบบไม่มีหน้าต่าง (batch/CI) ให้ใช้ run_batch.do แทน
#=====================================================================

onerror {puts "!! ERROR : ขั้นตอนล้มเหลว -- ดูข้อความข้างบน"; quit -code 90}

# --- กันไว้ไม่ให้รันผิดโฟลเดอร์ ------------------------------------
if {![file exists src/counter.vhd]} {
    puts "!! ผิดโฟลเดอร์ : [pwd]"
    puts "!! ต้องอยู่ในโฟลเดอร์ lab01_first_simulation"
    quit -code 2
}

puts "===================================================================="
puts " LAB 01 : first simulation"
puts " cwd    : [pwd]"
puts "===================================================================="

#--- 1. สร้าง work library ---------------------------------------------
#    vlib  = สร้างไลบรารี (โฟลเดอร์ที่เก็บ design unit ที่คอมไพล์แล้ว)
#    vmap  = ผูกชื่อไลบรารีเข้ากับโฟลเดอร์ บันทึกลง modelsim.ini
if {[file exists work]} { file delete -force work }
vlib work
vmap work work

#--- 2. คอมไพล์ไฟล์ VHDL ----------------------------------------------
#    -2008 = ใช้มาตรฐาน VHDL-2008 (จำเป็นสำหรับ std.env.finish)
vcom -2008 src/counter.vhd
vcom -2008 tb/tb_counter.vhd

#--- 3. โหลด design --------------------------------------------------
#    "work.tb_counter" = library.entity
vsim work.tb_counter

#--- 4. เปิดหน้าต่าง Wave แล้วเพิ่มสัญญาณทั้งหมด --------------------
add wave -r /tb_counter/*

#--- 5. รันจนจบ (รอบสุดท้าย TB จะเรียก std.env.finish) ---------------
run -all

puts "===================================================================="
puts " simulation stopped at [time]"
puts " -> เปิดหน้าต่าง Wave เพื่อดูรูปคลื่น"
puts "===================================================================="
# ตั้งใจไม่ quit เพื่อให้นักเรียนเล่นกับ waveform ต่อได้
# เมื่อจบแล้วพิมพ์ที่ prompt:  quit -f
