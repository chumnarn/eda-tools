@echo off
rem ==========================================================================
rem  TDI lab runner -- generated by tools\make-runners.ps1
rem
rem  Usage : run.cmd
rem
rem  Exit code : 0 = PASS, 1 = FAIL, 2 = wrong folder / tool not found
rem
rem  RULES for .cmd files on Windows (all of them verified on this machine):
rem    * Keep the file pure ASCII. Thai or UTF-8 text in a .cmd file makes
rem      cmd.exe mis-read the line structure -- a comment line can swallow
rem      the first character of the next line ("echo" becomes "cho").
rem    * Never leave an unescaped "(" or ")" inside an echo line that sits
rem      inside an if-block.
rem    * node exits with 0 only when the checker really succeeded, so the
rem      exit code of node IS the verdict of the lab.
rem ==========================================================================
setlocal

cd /d "%~dp0"

if not exist "results" mkdir "results"

set "SCRIPT=%~dp0..\tools\checks\check04_timing.js"
if not exist "%SCRIPT%" (
    echo [ERROR] checker not found: %SCRIPT%
    exit /b 2
)

where node >nul 2>&1
if errorlevel 1 (
    echo [ERROR] node.exe not found in PATH.
    echo         Install Node.js 18 or newer and open a new console.
    exit /b 2
)

echo =====================================================================
echo  LAB 04 : the timing constraints
echo  cwd    : %CD%
echo  expect : PASS
echo =====================================================================

node "%SCRIPT%" > "results\output.txt" 2>&1
set RC=%ERRORLEVEL%

type "results\output.txt"

if not "%RC%"=="0" (
    echo [RESULT] FAIL -- node exit=%RC%
    exit /b 1
)

echo PASS> "result.txt"
echo [RESULT] PASS
exit /b 0
