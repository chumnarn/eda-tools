        values( "245.80681, 251.51681, 273.72681, 342.61681, 529.21681" );
      }
   /* SI@F@Q@L */
      fall_power(power_table_17) { 
        values( "284.67885, 290.62885, 316.22886, 393.36885, 594.85885" );
      }
  }
  timing() {
   related_pin  : "CLK";
   timing_label : "SI_CLK_HOLD";
   timing_type  : hold_rising;
   sdf_edges    : both_edges;
   /* SI@CLK@HOLD@0@R */
      fall_constraint(table_18) { 
