                "-199.99999, -199.99999, -199.99999, -199.99999, -199.99999" );
      }
  }
  timing() {
   related_pin  : "CLK";
   timing_label : "SI_CLK_SETUP";
   timing_type  : setup_rising;
   sdf_edges    : both_edges;
   /* SI@CLK@SETUP@0@F */
