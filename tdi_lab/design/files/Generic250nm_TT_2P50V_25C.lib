                "409.43000, 418.32000, 425.95000, 428.29000, 451.29000" );
      }
  }
 }
 pin(SI) {
  direction          : input;
  related_power_pin  : vdd!;
  related_ground_pin : vss!;
  capacitance        : 5.27650;
  rise_capacitance   : 5.74880;
  fall_capacitance   : 4.80420;
  rise_capacitance_range(5.74880,5.74880);
  fall_capacitance_range(4.80420,4.80420);
  nextstate_type     : scan_in;
  max_transition     : 2000.00000;
  internal_power() {
   when           : "CLR&Q";
   related_pg_pin : "vdd!";
   /* SI@R@Q@H */
      rise_power(power_table_17) { 
        values( "245.42762, 251.15761, 273.77762, 342.72762, 529.38761" );
      }
   /* SI@F@Q@H */
      fall_power(power_table_17) { 
        values( "289.71407, 295.65407, 321.25408, 398.38407, 599.90408" );
      }
  }
  internal_power() {
   when           : "!Q";
   related_pg_pin : "vdd!";
