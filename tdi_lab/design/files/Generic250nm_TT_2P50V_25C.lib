 test_cell() {
  ff("IQ","IQN") {
   clocked_on : "CLK";
   next_state : "SD";
   clear      : "!CLR";
  }
  pin(Q) {
   direction   : output;
   signal_type : "test_scan_out";
   function    : "IQ";
  }
  pin(QB) {
   direction : output;
   function  : "IQN";
  }
  pin(CLK) {
   direction : input;
  }
  pin(SD) {
   direction : input;
  }
  pin(CLR) {
   direction : input;
  }
  pin(SE) {
   direction   : input;
   signal_type : "test_scan_enable";
  }
  pin(SI) {
   direction   : input;
   signal_type : "test_scan_in";
  }
 }
}

/*****************************************************************
  cell_description : Constant logic 0                              */

cell (TIELOW) {
  area : 0;
  pg_pin (vss!) {
    voltage_name : vss!;
    pg_type : primary_ground;
  }
  pg_pin (vdd!) {
    voltage_name : vdd!;
    pg_type : primary_power;
  }
  
  pin (Z) {
    direction : output;
    function : "0";
  }
}

/*****************************************************************
  cell_description : Constant logic 1                              */
  
cell (TIEHIGH) {
  area : 0;
  pg_pin (vss!) {
    voltage_name : vss!;
    pg_type : primary_ground;
  }
  pg_pin (vdd!) {
    voltage_name : vdd!;
    pg_type : primary_power;
  }
  
  pin (Z) {
    direction : output;
    function : "1";
  }
}

