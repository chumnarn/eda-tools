                "-199.99999, -199.99999, -199.99999, -185.51999, -181.15999" );
      }
  }
  timing() {
   related_pin  : "CLK";
   timing_label : "SE_CLK_SETUP_state_3";
   timing_type  : setup_rising;
   sdf_edges    : both_edges;
   when         : "CLR&SD&!SI";
   sdf_cond     : "AND_CLRSDSIX";
   /* SE@CLK@SETUP@0@R@1 */
      fall_constraint(table_19) { 
        values( "372.64000, 403.57000, 463.70000, 581.93000, 819.22000", \
                "366.21000, 397.22000, 457.39000, 575.58000, 812.84000", \
