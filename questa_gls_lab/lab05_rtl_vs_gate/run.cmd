@echo off
rem ==========================================================================
rem  Generic batch runner for the GLS labs that need TWO simulations
rem
rem  Generated by tools\make-runners.ps1 -- change the template, not the copies.
rem
rem  WHY TWO PROCESSES ?
rem  A ModelSim session can only do ONE simulation when the testbench ends
rem  with $finish : loading a second design in the same session and running
rem  it again ends the .do script silently, without an error message.
rem  Two separate vsim processes avoid that completely, give every run its
rem  own transcript and use the single-session licence one after the other.
rem
rem  Exit code : 0 = PASS, 1 = FAIL, 2 = wrong folder / tool not found
rem ==========================================================================
setlocal

call "%~dp0..\tools\pick_tool.cmd"
if not defined MT (
    echo [ERROR] no usable vsim.exe with a free licence was found.
    echo         Close any running ModelSim/QuestaSim GUI, or set
    echo         QUESTASIM_HOME / MODELSIM_HOME to a valid installation.
    exit /b 2
)
set "PATH=%MT%;%PATH%"
cd /d "%~dp0"
if not exist "run_rtl.do" (
    echo [ERROR] run_rtl.do not found in %CD%
    exit /b 2
)
if not exist "run_gls.do" (
    echo [ERROR] run_gls.do not found in %CD%
    exit /b 2
)

echo =====================================================================
echo  LAB 05 : one testbench, two levels
echo  cwd    : %CD%
echo  tool   : %MT%
echo  expect : PASS -- RTL and gate level give the same trace
echo =====================================================================

if exist result.txt del result.txt

rem --- step 1 : the RTL level run ----------------------------------------
echo [STEP 1] the RTL level run
vsim -c -onfinish stop -do "do run_rtl.do"

rem --- step 2 : the gate level run and the comparison --------------------
echo [STEP 2] the gate level run
vsim -c -onfinish stop -do "do run_gls.do"
set RC=%ERRORLEVEL%

if not exist "result.txt" (
    echo [RESULT] FAIL -- the simulator did not finish
    exit /b 1
)

set /p RESULT=<result.txt
if /i "%RESULT%"=="PASS" (
    echo [RESULT] PASS
    exit /b 0
)
echo [RESULT] FAIL -- exit=%RC%
exit /b 1
