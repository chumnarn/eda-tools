# =====================================================================
# ps_qor_8ns.tcl — รอบทดลองที่ 2: เป้าหมาย 8 ns (เข้มกว่าที่บอร์ดต้องการ)
#
# จุดประสงค์
#   ศึกษาผลของการ "บีบเวลาเกินจำเป็น" ต่อ QoR ทั้งด้านพื้นที่และเวลา
#   โดยเฉพาะเมื่อนำเน็ตลิสต์ไปประเมินหลัง routing ที่คาบเวลาจริง 10 ns
#
# คำถามที่ต้องตอบหลังทำเสร็จ (ดูรายละเอียดในบทที่ 5)
#   1) พื้นที่เพิ่มขึ้นกี่เปอร์เซ็นต์เมื่อเป้าหมายเข้มขึ้น
#   2) เวลาที่รายงานหลังสังเคราะห์ (pre-route) ดีขึ้นจริงหรือไม่
#   3) เมื่อประเมินหลัง routing ที่ 10 ns รอบไหนดีกว่า และเพราะอะไร
#
# วิธีใช้
#   ps_shell -f ps_qor_8ns.tcl
# =====================================================================

set sdc_file "../sdc/top_alu8_8ns.sdc"
set out_dir  "out_8ns"

source ps_build.tcl
