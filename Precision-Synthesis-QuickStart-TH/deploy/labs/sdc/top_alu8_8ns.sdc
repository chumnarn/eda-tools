# =====================================================================
# top_alu8_8ns.sdc — เหมือน top_alu8.sdc แต่เป้าหมายเวลาเข้มขึ้นเป็น 8 ns
#
# จุดประสงค์ของไฟล์นี้
#   ใช้เป็น "การทดลอง" ในบทที่ 5 เพื่อเปรียบเทียบ QoR ระหว่าง
#   การสังเคราะห์ด้วยเป้าหมาย 10 ns (ตามคาบเวลาจริงของบอร์ด)
#   กับการสังเคราะห์ด้วยเป้าหมาย 8 ns (125 MHz ซึ่งบอร์ดไม่ได้มี)
#
#   ข้อสังเกตสำคัญ: แม้แต่สังเคราะห์ด้วยเป้าหมาย 8 ns
#   เมื่อนำไปประเมินหลัง routing ด้วยเงื่อนไข 10 ns ของบอร์ด
#   ผลลัพธ์อาจไม่ดีกว่าแบบ 10 ns เสมอไป เพราะการบีบเวลาเกินจำเป็น
#   ทำให้ตัวสังเคราะห์ตัดสินใจใช้ทรัพยากรมากขึ้น
#
#   หมายเหตุ: เงื่อนไข input/output delay ถูกลดลงเหลือ 1.5 ns
#   เพื่อให้สัดส่วนของเวลาสำหรับตรรกะภายในมากขึ้นเท่า ๆ กัน
#   ตามหลักของการตั้งเป้าหมายที่เข้มขึ้น (เป้าหมายของเส้นทางภายใน
#   จึงเคร่งขึ้นจาก 6 ns เป็น 5 ns)
# =====================================================================

create_clock -name sys_clk -period 8.000 -waveform {0.000 4.000} \
             [get_ports {CLK100MHZ}]

set_input_delay  -clock sys_clk -max 1.500 [get_ports {SW[*]}]
set_input_delay  -clock sys_clk -max 1.500 [get_ports {BTN[*]}]

set_output_delay -clock sys_clk -max 1.500 [get_ports {LED[*]}]
set_output_delay -clock sys_clk -max 1.500 [get_ports {AN[*]}]
set_output_delay -clock sys_clk -max 1.500 [get_ports {SEG[*]}]

set_false_path -from [get_ports {CPU_RESETN}]
