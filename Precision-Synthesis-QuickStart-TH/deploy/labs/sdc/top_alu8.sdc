# =====================================================================
# top_alu8.sdc — เงื่อนไขเวลาสำหรับบอร์ด Digilent Nexys A7-100T
# เป้าหมาย: 100 MHz (คาบเวลา 10.000 ns) ตามนาฬิกาหลักบนบอร์ด
#
# ใช้กับ:
#   - Precision Synthesis (ผ่าน File > Add Files หรือ read_sdc)
#   - เทียบเคียงกับ XDC ใน labs/vivado/nexys_a7_100t.xdc
#
# ข้อควรรู้
#   - ค่า input/output delay ที่ใช้เป็นค่าตัวอย่างเชิงวิศวกรรม
#     ต้องปรับตามเวลาที่ออกแบบจริง (เช่น เวลาจัดระเบียบของสวิตช์/ปุ่ม)
#   - เส้นทางรีเซ็ตเป็น asynchronous จึงตัดออกจากการวิเคราะห์
#     (ส่วนเงื่อนไข recovery/removal ควรจัดการแยกต่างหากใช้จริง)
# =====================================================================

# ---------------------------------------------------------------------
# 1) นาฬิกาหลัก: คาบเวลา 10.000 ns = 100 MHz
# ---------------------------------------------------------------------
create_clock -name sys_clk -period 10.000 -waveform {0.000 5.000} \
             [get_ports {CLK100MHZ}]

# ---------------------------------------------------------------------
# 2) เวลาหน่วงของอินพุตที่มาจากภายนอกชิป
#    (สวิตช์และปุ่มบนบอร์ด ถือว่าสลับที่ขอบนาฬิกา)
# ---------------------------------------------------------------------
set_input_delay -clock sys_clk -max 2.000 [get_ports {SW[*]}]
set_input_delay -clock sys_clk -max 2.000 [get_ports {BTN[*]}]

# ---------------------------------------------------------------------
# 3) เวลาที่ต้องใช้ในการขับเอาต์พุต (LED และจอ 7 ส่วน)
# ---------------------------------------------------------------------
set_output_delay -clock sys_clk -max 2.000 [get_ports {LED[*]}]
set_output_delay -clock sys_clk -max 2.000 [get_ports {AN[*]}]
set_output_delay -clock sys_clk -max 2.000 [get_ports {SEG[*]}]

# ---------------------------------------------------------------------
# 4) ตัดเส้นทางรีเซ็ต (asynchronous reset)
# ---------------------------------------------------------------------
set_false_path -from [get_ports {CPU_RESETN}]
